{
  "name": "zclaw",
  "version": "2.0.72",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/gateway/index.js",
  "bin": {
    "zclaw": "bin/zclaw"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-gateway-web.mjs",
    "start": "node dist/gateway/index.js",
    "start:gateway": "node dist/gateway/index.js",
    "start:worker": "node dist/worker/index.js",
    "dev": "tsx src/gateway/index.ts",
    "dev:gateway": "tsx src/gateway/index.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "worker": "node dist/worker/index.js",
    "worker:dev": "tsx src/worker/index.ts",
    "gateway": "node dist/gateway/index.js",
    "gateway:dev": "tsx src/gateway/index.ts",
    "zclaw": "tsx setup/services/cli.ts",
    "service:install": "tsx setup/services/cli.ts service install",
    "service:start": "tsx setup/services/cli.ts start",
    "service:stop": "tsx setup/services/cli.ts stop",
    "service:status": "tsx setup/services/cli.ts status",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/core": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint": "0.1.1",
    "@onecli-sh/sdk": "^0.5.0",
    "better-sqlite3": "11.10.0",
    "chat": "^4.24.0",
    "cron-parser": "5.5.0",
    "kleur": "^4.1.5",
    "pg": "^8.23.0",
    "playwright-core": "1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
