# NanoClaw env (gateway + worker)

# Role for this machine: both | gateway | worker
# NANOCLAW_ROLE=both

# --- Worker HTTP API ---
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8080
# WORKER_AUTH_TOKEN=
# When gateway is remote, worker must be reachable:
# WORKER_HOST=0.0.0.0

# --- Gateway HTTP API ---
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8090
# GATEWAY_AUTH_TOKEN=
# GATEWAY_WORKER_URL=http://127.0.0.1:8080
# GATEWAY_PUBLIC_URL=http://127.0.0.1:8090
# Split machines: set GATEWAY_WORKER_URL to the worker host and
# GATEWAY_PUBLIC_URL to the gateway host (what the worker calls back).

# ONECLI_URL=http://127.0.0.1:10254
# ONECLI_API_KEY=

# Optional: durable agent knowledge store (Postgres).
# Required for knowledge_save / knowledge_search / knowledge_get.
# NanoClaw setup does NOT install this DB — provide your own Postgres.
# Do not reuse OneCLI's Postgres (usually port 5432) for this.
# Example uses 5433 to avoid that clash:
# KNOWLEDGE_DATABASE_URL=postgresql://nanoclaw:nanoclaw@127.0.0.1:5433/nanoclaw_knowledge
# KNOWLEDGE_ENABLED=true
# Init schema (optional if gateway startup already runs it):
#   pnpm exec tsx scripts/init-knowledge-db.ts
# See docs/setup-install.md#agent-knowledge-store-knowledge_database_url

# Optional: live browser stream via gateway
# LIVE_BROWSER_ENABLED=false

# Multi-agent orchestration (default on)
# MULTI_AGENT_ORCHESTRATION_ENABLED=true
