# Safety net — pnpm-workspace.yaml has the authoritative minimumReleaseAge (4320 min = 3 days)
# This .npmrc value is a fallback if npm is ever invoked directly
minReleaseAge=3d

# Native dependencies must use published binaries. Do not compile from source
# during install (better-sqlite3 13 ships prebuilds; esbuild/sharp download theirs).
build-from-source=false
