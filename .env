ONECLI_URL=http://127.0.0.1:10254
#ZOHO_CLIQ_CLIENT_ID=
#ZOHO_CLIQ_CLIENT_SECRET=
#ZOHO_CLIQ_CHANNEL_ENDPOINT=https://cliq.zoho.com/company/929053958/api/v2/channelsbyname/nanobot/message
#ZOHO_CLIQ_BOT_UNIQUE_NAME=nanobot
ZOHO_CLIQ_API_URL=https://cliq.zoho.com
ZOHO_CLIQ_ACCOUNTS_URL=https://accounts.zoho.com
#ZOHO_CLIQ_CHAT_ID=
KNOWLEDGE_DATABASE_URL=postgresql://nanoclaw:nanoclaw@127.0.0.1:5433/nanoclaw_knowledge

# Headed browser login (gateway on WSL → Windows Chrome)

CHROME_PATH=/usr/bin/chromium-browser

# Ollama (Anthropic-compatible) — all Claude-provider agents
#ANTHROPIC_BASE_URL=http://127.0.0.1:11434
#ANTHROPIC_BASE_URL=
#NO_PROXY=localhost,127.0.0.1
#no_proxy=localhost,127.0.0.1
# Claude Code Anthropic phone-home (bootstrap/telemetry/metrics) is OFF by default.
# Set to true only if you explicitly want that traffic through OneCLI → api.anthropic.com.
#CLAUDE_CODE_ALLOW_NONESSENTIAL_TRAFFIC=true
LIVE_BROWSER_ENABLED=true
LIVE_BROWSER_STREAM_PORT=9223
# Builder/edit turns (orchestrator builds are heavier; remote Ollama is slower).
# Default in code is 600000 (10m). 120000 (2m) was timing out mid-turn.
WORKER_BUILD_TURN_TIMEOUT_MS=1800000
WORKER_BUILD_PROGRESS_INTERVAL_MS=300000   # 5m (default)
WORKER_BUILD_TURN_MAX_MS=7200000  # 120m (default)
# Multi-agent orchestrators via /build + /use (default on). Set false to force single-agent builds only.
MULTI_AGENT_ORCHESTRATION_ENABLED=true
WORKER_OUTBOUND_FILE_MAX_BYTES=52428800 # 50MB

# Optional gateway browser chat (served by gateway at /chat)
CHATBOT_UI_ENABLED=true

